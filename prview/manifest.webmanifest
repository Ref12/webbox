{
  "name": "PR viewer",
  "short_name": "PR viewer",
  "description": "Review GitHub pull requests the way Azure DevOps shows them.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14161b",
  "theme_color": "#0f6cbd",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
