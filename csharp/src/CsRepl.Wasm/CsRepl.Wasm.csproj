<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Interpreter only (no AOT), single-threaded, no native relink => no wasm-tools workload needed. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
    <!-- dotnet publish -p:Threads=true: the experimental multithreaded runtime (needs COOP/COEP; shipped behind ?threads=1) -->
    <WasmEnableThreads Condition="'$(Threads)' == 'true'">true</WasmEnableThreads>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmDebugLevel>0</WasmDebugLevel>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <CompressionEnabled>true</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- the JS that csharp/ and sharplab/ share (shared/js) is served from this app's root, next to its own scripts -->
    <Content Include="../../../shared/js/*.js" Link="wwwroot/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CsRepl.Core/CsRepl.Core.csproj" />
    <ProjectReference Include="../../../shared/IntelliHost/WebBox.IntelliHost.csproj" />
  </ItemGroup>
</Project>
