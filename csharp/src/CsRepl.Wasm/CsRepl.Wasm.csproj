<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- before the import: the props decide which packs to fetch from these -->
  <PropertyGroup>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../../build/NoWorkloadWasm.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Interpreter only (no AOT), single-threaded, no native relink => no wasm-tools workload needed. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
    <!-- dotnet publish -p:Threads=true: the experimental multithreaded runtime (needs COOP/COEP; shipped behind ?threads=1) -->
    <WasmEnableThreads Condition="'$(Threads)' == 'true'">true</WasmEnableThreads>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmDebugLevel>0</WasmDebugLevel>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <CompressionEnabled>true</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CsRepl.Core/CsRepl.Core.csproj" />
  </ItemGroup>
  <!-- AOT needs IL trimming; the framework assemblies that user code and Roslyn-emitted code load by name must survive it -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="System.Runtime;System.Linq;System.Collections;System.Console;System.Private.CoreLib;System.Runtime.Extensions;System.Threading;System.Threading.Tasks;System.Text.RegularExpressions;System.Linq.Expressions;System.Collections.Concurrent;System.Collections.Immutable;System.Memory;System.Numerics;System.Text.Json;System.Net.Http;System.IO;System.Globalization;System.ComponentModel;System.Diagnostics.Debug;System.Runtime.InteropServices;System.Runtime.Numerics;System.Linq.Queryable;System.ObjectModel;System.Private.Uri;System.Xml.Linq;System.Collections.NonGeneric;System.Collections.Specialized" />
    <TrimmerRootAssembly Include="Microsoft.CSharp" />
    <!-- System.Text.Json binds records by constructor parameter names: keep the app assemblies whole -->
    <TrimmerRootAssembly Include="CsRepl.Core;CsRepl.Wasm" />
  </ItemGroup>
</Project>
