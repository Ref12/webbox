<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- before the import: the props decide which packs to fetch from these -->
  <PropertyGroup>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../../build/NoWorkloadWasm.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Interpreter only (no AOT), single-threaded, no native relink => no wasm-tools workload needed (same as csharp/). -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmDebugLevel>0</WasmDebugLevel>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <CompressionEnabled>true</CompressionEnabled>
    <!-- served from /webbox/sharplab/: every URL in the page is relative -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <!-- the JS that sharplab/ and csharp/ share (shared/js) is served from this app's root, next to its own scripts -->
    <Content Include="../../../shared/js/*.js" Link="wwwroot/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SharpLab.Core/SharpLab.Core.csproj" />
    <ProjectReference Include="../../../shared/IntelliHost/WebBox.IntelliHost.csproj" />
  </ItemGroup>
  <!-- ILVerify (a plain DLL reference of SharpLab.Core) is dropped from the publish set by the relink pipeline unless the app references it too -->
  <ItemGroup>
    <Reference Include="ILVerify" HintPath="../../lib/ILVerify.dll" />
  </ItemGroup>
  <!-- AOT needs IL trimming; the framework assemblies that user code and Roslyn-emitted code load by name must survive it -->
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- AOT build: trim only the framework (partial); third-party assemblies (ILVerify, decompiler, Roslyn) stay whole, as the AOT compiler needs them to load -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="System.Runtime;System.Linq;System.Collections;System.Console;System.Private.CoreLib;System.Runtime.Extensions;System.Threading;System.Threading.Tasks;System.Text.RegularExpressions;System.Linq.Expressions;System.Collections.Concurrent;System.Collections.Immutable;System.Memory;System.Numerics;System.Text.Json;System.Net.Http;System.IO;System.Globalization;System.ComponentModel;System.Diagnostics.Debug;System.Runtime.InteropServices;System.Runtime.Numerics;System.Linq.Queryable;System.ObjectModel;System.Private.Uri;System.Xml.Linq;System.Collections.NonGeneric;System.Collections.Specialized" />
    <TrimmerRootAssembly Include="Microsoft.CSharp;WebBox.IntelliHost;ILVerify" />
    <!-- mono-aot-cross cannot load the ILVerify reference while precompiling SharpLab.Core: leave that small assembly interpreted, Roslyn and the decompiler are still AOT -->
    <_AOT_InternalForceInterpretAssemblies Include="SharpLab.Core.dll;ILVerify.dll" />
    <!-- what NuGet packages loaded at run time commonly bind to (Newtonsoft.Json: serialization binder, XML, data) -->
    <TrimmerRootAssembly Include="System.Runtime.Serialization.Formatters;System.Runtime.Serialization.Primitives;System.Private.Xml;System.Private.Xml.Linq;System.Xml.ReaderWriter;System.Data.Common;System.ComponentModel.TypeConverter;System.ComponentModel.Primitives;System.Runtime.Loader;System.Reflection.Emit;System.Reflection.Emit.Lightweight;System.Reflection.Emit.ILGeneration;System.Reflection.Primitives;System.Reflection.TypeExtensions" />
    <!-- Roslyn Features (lazy-loaded, MEF/reflection) may reach any framework API: in the AOT build keep every framework assembly that user code could reference whole -->
    <_RefAsm Include="$(MSBuildThisFileDirectory)wwwroot/ref/a/*.dll" />
    <TrimmerRootAssembly Include="@(_RefAsm->'%(Filename)')" />
    <!-- System.Text.Json binds records by constructor parameter names: keep the app assemblies whole -->
    <TrimmerRootAssembly Include="SharpLab.Core;SharpLab.Wasm" />
  </ItemGroup>
</Project>
