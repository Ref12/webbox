<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SharpLab</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
  </ItemGroup>
  <ItemGroup>
    <!-- ILVerify.dll from the dotnet-ilverify 10.0.12 tool package (MIT); the ILVerification library itself is not on nuget.org. See lib/README. -->
    <Reference Include="ILVerify" HintPath="../../lib/ILVerify.dll" />
  </ItemGroup>
</Project>
